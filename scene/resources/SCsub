#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

# Thirdparty code

thirdparty_obj = []

thirdparty_dir = "#thirdparty/misc/"
thirdparty_sources = [
    "mikktspace.c",
]

if not env["disable_audio_stream_wav"]:
    thirdparty_sources.append("qoa.c")

thirdparty_sources = [thirdparty_dir + file for file in thirdparty_sources]

env_thirdparty = env.Clone()
env_thirdparty.disable_warnings()
env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)
env.scene_sources += thirdparty_obj

# Godot source files

scene_obj = []

if env["disable_audio_stream_wav"] or env["disable_camera_server"]:
    # Exclude files when disabled
    import glob
    import os
    cpp_files = glob.glob(os.path.join(str(Dir(".").srcnode()), "*.cpp"))
    exclude_patterns = []
    if env["disable_audio_stream_wav"]:
        exclude_patterns.append("audio_stream_wav")
    if env["disable_camera_server"]:
        exclude_patterns.append("camera_texture")
    cpp_files = [os.path.basename(f) for f in cpp_files if not any(pattern in f for pattern in exclude_patterns)]
    for f in cpp_files:
        env.add_source_files(scene_obj, f)
else:
    env.add_source_files(scene_obj, "*.cpp")

env.scene_sources += scene_obj

# Needed to force rebuilding the scene files when the thirdparty code is updated.
env.Depends(scene_obj, thirdparty_obj)

SConscript("2d/SCsub")
if not env["disable_3d"]:
    SConscript("3d/SCsub")
